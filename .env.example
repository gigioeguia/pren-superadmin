APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# debe matchear el host que sirve la app; el Host header se valida (TrustHosts, Seg-21)
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Demo (Fase 5 / 5.2): password de los 4 usuarios demo — solo evaluación local, nunca producción.
# Vacía => se genera una aleatoria por usuario y se imprime al ejecutar migrate --seed.
DEMO_USER_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_LIFETIME=1800
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
# La cookie de sesión toma Secure automáticamente cuando APP_URL es https.
# Descomenta para forzar true/false manualmente (p.ej. http detrás de TLS-terminating proxy).
# SESSION_SECURE_COOKIE=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Payment gateways (rellenar en producción; nunca commitear valores reales)
STRIPE_KEY=
STRIPE_SECRET=
MOLLIE_API_KEY=
FEDAPAY_API_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
TAP_SECRET_KEY=
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
